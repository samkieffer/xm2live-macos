#!/usr/bin/env python3
"""
Convertisseur XM vers Ableton Live - Version avec extraction MIDI
Extrait les samples ET les notes MIDI avec structure par canal
"""

import sys
import os
import struct
import gzip
import xml.etree.ElementTree as ET
from xml.dom import minidom
import wave
import numpy as np
from pathlib import Path
from collections import defaultdict

def read_xm_header(filepath):
    """Lit les infos de base du fichier XM"""
    with open(filepath, 'rb') as f:
        id_text = f.read(17).decode('ascii', errors='ignore')
        if not id_text.startswith("Extended Module"):
            return None
        
        module_name = f.read(20).decode('ascii', errors='ignore').strip('\x00')
        f.read(1)  # 0x1a
        tracker_name = f.read(20).decode('ascii', errors='ignore').strip('\x00')
        
        f.read(2)  # version
        f.read(4)  # header size
        
        song_length = int.from_bytes(f.read(2), 'little')
        restart_pos = int.from_bytes(f.read(2), 'little')
        num_channels = int.from_bytes(f.read(2), 'little')
        num_patterns = int.from_bytes(f.read(2), 'little')
        num_instruments = int.from_bytes(f.read(2), 'little')
        flags = int.from_bytes(f.read(2), 'little')
        default_tempo = int.from_bytes(f.read(2), 'little')
        default_bpm = int.from_bytes(f.read(2), 'little')
        
        pattern_order = list(f.read(256))[:song_length]
        
        return {
            'name': module_name,
            'tracker': tracker_name,
            'song_length': song_length,
            'channels': num_channels,
            'patterns': num_patterns,
            'instruments': num_instruments,
            'tempo': default_tempo,
            'bpm': default_bpm,
            'pattern_order': pattern_order
        }

def read_patterns(f, num_patterns, num_channels):
    """Lit tous les patterns du XM"""
    patterns = []
    
    for i in range(num_patterns):
        try:
            pattern_header_len = struct.unpack('<I', f.read(4))[0]
            packing_type = struct.unpack('<B', f.read(1))[0]
            num_rows = struct.unpack('<H', f.read(2))[0]
            packed_size = struct.unpack('<H', f.read(2))[0]
            
            # Skip reste du header
            remaining_header = pattern_header_len - 9
            if remaining_header > 0:
                f.read(remaining_header)
            
            # Lire les données du pattern
            pattern_data = []
            if packed_size > 0:
                data = f.read(packed_size)
                pattern_data = parse_pattern_data(data, num_rows, num_channels)
            
            patterns.append({
                'number': i,
                'rows': num_rows,
                'data': pattern_data
            })
            
            print(f"  Pattern {i+1}/{num_patterns}: {num_rows} rows, {len(pattern_data)} notes")
            
        except Exception as e:
            print(f"  Erreur pattern {i+1}: {e}")
            patterns.append({'number': i, 'rows': 64, 'data': []})
    
    return patterns

def parse_pattern_data(data, num_rows, num_channels):
    """Parse les données d'un pattern XM"""
    notes = []
    pos = 0
    
    for row in range(num_rows):
        for channel in range(num_channels):
            if pos >= len(data):
                break
            
            # Lire le premier byte
            note_byte = data[pos]
            pos += 1
            
            note = None
            instrument = None
            volume = None
            effect_type = None
            effect_param = None
            
            if note_byte & 0x80:  # Packed note
                if note_byte & 0x01:  # Note présente
                    if pos < len(data):
                        note = data[pos]
                        pos += 1
                
                if note_byte & 0x02:  # Instrument présent
                    if pos < len(data):
                        instrument = data[pos]
                        pos += 1
                
                if note_byte & 0x04:  # Volume présent
                    if pos < len(data):
                        volume = data[pos]
                        pos += 1
                
                if note_byte & 0x08:  # Effect type présent
                    if pos < len(data):
                        effect_type = data[pos]
                        pos += 1
                
                if note_byte & 0x10:  # Effect param présent
                    if pos < len(data):
                        effect_param = data[pos]
                        pos += 1
            else:  # Unpacked note (5 bytes)
                note = note_byte
                if pos + 3 < len(data):
                    instrument = data[pos]
                    volume = data[pos + 1]
                    effect_type = data[pos + 2]
                    effect_param = data[pos + 3]
                    pos += 4
            
            # Si on a une note valide et un instrument
            if note and note > 0 and note < 97 and instrument and instrument > 0:
                notes.append({
                    'row': row,
                    'channel': channel,
                    'note': note,
                    'instrument': instrument,
                    'volume': volume if volume else 64,
                    'effect_type': effect_type,
                    'effect_param': effect_param
                })
    
    return notes

def extract_samples_and_patterns(xm_path, samples_dir):
    """Extrait les samples ET les patterns du XM"""
    samples = []
    patterns = []
    xm_info = None
    
    with open(xm_path, 'rb') as f:
        # Lire le header principal
        id_text = f.read(17)
        module_name = f.read(20).decode('ascii', errors='ignore').strip('\x00')
        f.read(1)  # 0x1a
        tracker_name = f.read(20)
        version = struct.unpack('<H', f.read(2))[0]
        
        header_size = struct.unpack('<I', f.read(4))[0]
        song_length = struct.unpack('<H', f.read(2))[0]
        restart_pos = struct.unpack('<H', f.read(2))[0]
        num_channels = struct.unpack('<H', f.read(2))[0]
        num_patterns = struct.unpack('<H', f.read(2))[0]
        num_instruments = struct.unpack('<H', f.read(2))[0]
        flags = struct.unpack('<H', f.read(2))[0]
        default_tempo = struct.unpack('<H', f.read(2))[0]
        default_bpm = struct.unpack('<H', f.read(2))[0]
        pattern_order = list(f.read(256))[:song_length]
        
        xm_info = {
            'name': module_name,
            'channels': num_channels,
            'bpm': default_bpm,
            'pattern_order': pattern_order,
            'song_length': song_length
        }
        
        print(f"\nInfos: {num_instruments} instruments, {num_patterns} patterns, {num_channels} canaux")
        
        # Lire les patterns
        print("\nLecture des patterns...")
        patterns = read_patterns(f, num_patterns, num_channels)
        
        # Lire les instruments et samples
        print("\nLecture des instruments...")
        for inst_num in range(num_instruments):
            try:
                inst_header_size = struct.unpack('<I', f.read(4))[0]
                
                if inst_header_size < 29:
                    continue
                
                inst_name = f.read(22).decode('ascii', errors='ignore').strip('\x00')
                inst_type = struct.unpack('<B', f.read(1))[0]
                num_samples = struct.unpack('<H', f.read(2))[0]
                
                print(f"\nInstrument {inst_num+1}: '{inst_name}', {num_samples} samples")
                
                if num_samples > 0 and num_samples < 256:
                    sample_header_size = struct.unpack('<I', f.read(4))[0]
                    
                    remaining = inst_header_size - 33
                    if remaining > 0:
                        f.read(remaining)
                    
                    # Lire les headers de samples
                    sample_headers = []
                    for j in range(num_samples):
                        sample_len = struct.unpack('<I', f.read(4))[0]
                        loop_start = struct.unpack('<I', f.read(4))[0]
                        loop_len = struct.unpack('<I', f.read(4))[0]
                        volume = struct.unpack('<B', f.read(1))[0]
                        finetune = struct.unpack('<b', f.read(1))[0]
                        sample_type = struct.unpack('<B', f.read(1))[0]
                        panning = struct.unpack('<B', f.read(1))[0]
                        relative_note = struct.unpack('<b', f.read(1))[0]
                        reserved = struct.unpack('<B', f.read(1))[0]
                        sample_name = f.read(22).decode('ascii', errors='ignore').strip('\x00')
                        
                        sample_headers.append({
                            'length': sample_len,
                            'loop_start': loop_start,
                            'loop_length': loop_len,
                            'volume': volume,
                            'type': sample_type,
                            'name': sample_name or inst_name or f"Sample_{inst_num+1}_{j+1}",
                            'relative_note': relative_note
                        })
                    
                    # Lire les données des samples
                    for j, header in enumerate(sample_headers):
                        if header['length'] > 0 and header['length'] < 10000000:
                            sample_data = f.read(header['length'])
                            
                            is_16bit = header['type'] & 0x10
                            
                            if is_16bit:
                                data = np.frombuffer(sample_data, dtype=np.int16)
                            else:
                                data = np.frombuffer(sample_data, dtype=np.int8).astype(np.int16) * 256
                            
                            # Delta decode
                            if len(data) > 0:
                                decoded = np.zeros(len(data), dtype=np.int16)
                                current = np.int16(0)
                                for k in range(len(data)):
                                    current = np.int16(current + data[k])
                                    decoded[k] = current
                                
                                # Save as WAV
                                safe_name = "".join(c for c in header['name'] if c.isalnum() or c in (' ', '_', '-')).strip()
                                if not safe_name:
                                    safe_name = f"Instrument_{inst_num+1}_Sample_{j+1}"
                                
                                wav_path = os.path.join(samples_dir, f"{safe_name}.wav")
                                
                                counter = 1
                                while os.path.exists(wav_path):
                                    wav_path = os.path.join(samples_dir, f"{safe_name}_{counter}.wav")
                                    counter += 1
                                
                                with wave.open(wav_path, 'w') as wav:
                                    wav.setnchannels(1)
                                    wav.setsampwidth(2)
                                    wav.setframerate(8363)
                                    wav.writeframes(decoded.tobytes())
                                
                                samples.append({
                                    'instrument': inst_num + 1,
                                    'sample': j + 1,
                                    'name': header['name'],
                                    'path': wav_path,
                                    'relative_note': header['relative_note']
                                })
                                
                                print(f"    ✓ {safe_name}")
                else:
                    remaining = inst_header_size - 29
                    if remaining > 0:
                        f.read(remaining)
                        
            except Exception as e:
                print(f"  Erreur instrument {inst_num+1}: {e}")
                continue
    
    return samples, patterns, xm_info

def organize_tracks_by_channel(patterns, pattern_order, samples, num_channels):
    """Organise les notes par canal et par instrument"""
    # Structure: channel -> instrument -> notes
    tracks = defaultdict(lambda: defaultdict(list))
    
    # Parcourir les patterns dans l'ordre de la song
    current_time = 0.0
    
    for pattern_idx in pattern_order:
        if pattern_idx >= len(patterns):
            continue
        
        pattern = patterns[pattern_idx]
        
        for note_event in pattern['data']:
            channel = note_event['channel']
            instrument = note_event['instrument']
            row = note_event['row']
            
            # Calculer le temps en beats (4 rows = 1 beat en général)
            time_in_pattern = row / 4.0
            absolute_time = current_time + time_in_pattern
            
            # Convertir la note XM (1-96) en MIDI (0-127)
            # Note 1 = C-0, Note 49 = C-4 (middle C = MIDI 60)
            midi_note = note_event['note'] - 1 + 12  # Ajustement
            
            # Velocity depuis volume (0-64 -> 0-127)
            velocity = min(127, note_event['volume'] * 2)
            
            tracks[channel][instrument].append({
                'time': absolute_time,
                'note': midi_note,
                'velocity': velocity,
                'duration': 0.25  # Durée par défaut
            })
        
        # Avancer le temps (nombre de rows dans le pattern / 4)
        current_time += pattern['rows'] / 4.0
    
    return tracks

def create_sampler_device(sample_path, project_dir, device_id):
    """Crée un device Sampler avec le sample chargé"""
    
    rel_path = os.path.relpath(sample_path, project_dir)
    
    sampler = ET.Element('OriginalSimpler')
    ET.SubElement(sampler, 'LomId', attrib={'Value': str(device_id)})
    ET.SubElement(sampler, 'LomIdView', attrib={'Value': '0'})
    ET.SubElement(sampler, 'IsExpanded', attrib={'Value': 'true'})
    ET.SubElement(sampler, 'On', attrib={'Value': 'true'})
    ET.SubElement(sampler, 'ModulationSourceCount', attrib={'Value': '0'})
    ET.SubElement(sampler, 'ParametersListWrapper')
    ET.SubElement(sampler, 'Pointee', attrib={'Id': str(device_id)})
    ET.SubElement(sampler, 'LastSelectedTimeableIndex', attrib={'Value': '0'})
    ET.SubElement(sampler, 'LastSelectedModulationIndex', attrib={'Value': '-1'})
    ET.SubElement(sampler, 'LastPresetRef')
    ET.SubElement(sampler, 'LockedScripts')
    ET.SubElement(sampler, 'IsFolded', attrib={'Value': 'false'})
    ET.SubElement(sampler, 'ShouldBeAutoCollapsed', attrib={'Value': 'false'})
    ET.SubElement(sampler, 'UserName', attrib={'Value': ''})
    ET.SubElement(sampler, 'Annotation', attrib={'Value': ''})
    
    # Sample reference
    sample_ref = ET.SubElement(sampler, 'SampleRef')
    file_ref = ET.SubElement(sample_ref, 'FileRef')
    ET.SubElement(file_ref, 'HasRelativePath', attrib={'Value': 'true'})
    ET.SubElement(file_ref, 'RelativePathType', attrib={'Value': '3'})
    
    rel_path_elem = ET.SubElement(file_ref, 'RelativePath')
    for part in Path(rel_path).parts:
        ET.SubElement(rel_path_elem, 'RelativePathElement', attrib={'Id': part})
    
    ET.SubElement(file_ref, 'Name', attrib={'Value': os.path.basename(sample_path)})
    ET.SubElement(file_ref, 'Type', attrib={'Value': '1'})
    ET.SubElement(file_ref, 'Data')
    ET.SubElement(file_ref, 'RefersToFolder', attrib={'Value': 'false'})
    ET.SubElement(file_ref, 'SearchHint')
    ET.SubElement(file_ref, 'LastModDate', attrib={'Value': '0'})
    
    # MultiSampleMap
    multi_sample = ET.SubElement(sampler, 'MultiSampleMap')
    sample_parts = ET.SubElement(multi_sample, 'SampleParts')
    multi_sample_part = ET.SubElement(sample_parts, 'MultiSamplePart')
    ET.SubElement(multi_sample_part, 'LomId', attrib={'Value': '0'})
    ET.SubElement(multi_sample_part, 'KeyRange', attrib={'Min': '0', 'Max': '127'})
    ET.SubElement(multi_sample_part, 'VelocityRange', attrib={'Min': '0', 'Max': '127'})
    ET.SubElement(multi_sample_part, 'SelectorRange', attrib={'Min': '0', 'Max': '127'})
    ET.SubElement(multi_sample_part, 'RootKey', attrib={'Value': '60'})
    ET.SubElement(multi_sample_part, 'Detune', attrib={'Value': '0'})
    ET.SubElement(multi_sample_part, 'TuneCents', attrib={'Value': '0'})
    ET.SubElement(multi_sample_part, 'PitchKeyTrack', attrib={'Value': '1'})
    
    # Volume
    volume = ET.SubElement(sampler, 'Volume')
    ET.SubElement(volume, 'Manual', attrib={'Value': '1'})
    
    return sampler

def create_midi_clip_with_notes(notes, clip_id):
    """Crée un clip MIDI avec les vraies notes du XM"""
    
    if not notes:
        return None
    
    # Calculer la durée totale
    max_time = max(note['time'] for note in notes) + 4.0  # +4 beats de marge
    
    clip = ET.Element('MidiClip', attrib={'Id': str(clip_id)})
    ET.SubElement(clip, 'LomId', attrib={'Value': str(clip_id)})
    ET.SubElement(clip, 'LomIdView', attrib={'Value': '0'})
    ET.SubElement(clip, 'CurrentStart', attrib={'Value': '0'})
    ET.SubElement(clip, 'CurrentEnd', attrib={'Value': str(max_time)})
    
    loop_elem = ET.SubElement(clip, 'Loop')
    ET.SubElement(loop_elem, 'LoopStart', attrib={'Value': '0'})
    ET.SubElement(loop_elem, 'LoopEnd', attrib={'Value': str(max_time)})
    ET.SubElement(loop_elem, 'StartRelative', attrib={'Value': '0'})
    ET.SubElement(loop_elem, 'LoopOn', attrib={'Value': 'true'})
    ET.SubElement(loop_elem, 'OutMarker', attrib={'Value': str(max_time)})
    ET.SubElement(loop_elem, 'HiddenLoopStart', attrib={'Value': '0'})
    ET.SubElement(loop_elem, 'HiddenLoopEnd', attrib={'Value': str(max_time)})
    
    ET.SubElement(clip, 'Name', attrib={'Value': 'XM Notes'})
    ET.SubElement(clip, 'Annotation', attrib={'Value': ''})
    ET.SubElement(clip, 'Color', attrib={'Value': '-1'})
    ET.SubElement(clip, 'LaunchMode', attrib={'Value': '0'})
    ET.SubElement(clip, 'LaunchQuantisation', attrib={'Value': '0'})
    
    # Grouper les notes par hauteur
    notes_by_key = defaultdict(list)
    for note in notes:
        midi_key = int(note['note'])
        if 0 <= midi_key <= 127:
            notes_by_key[midi_key].append(note)
    
    # Notes MIDI
    notes_elem = ET.SubElement(clip, 'Notes')
    key_tracks = ET.SubElement(notes_elem, 'KeyTracks')
    
    for midi_key, key_notes in sorted(notes_by_key.items()):
        key_track = ET.SubElement(key_tracks, 'KeyTrack', attrib={'Id': str(midi_key)})
        ET.SubElement(key_track, 'MidiKey', attrib={'Value': str(midi_key)})
        notes_container = ET.SubElement(key_track, 'Notes')
        
        for i, note in enumerate(key_notes):
            midi_note = ET.SubElement(notes_container, 'MidiNoteEvent', attrib={'Id': str(i)})
            ET.SubElement(midi_note, 'Time', attrib={'Value': str(note['time'])})
            ET.SubElement(midi_note, 'Duration', attrib={'Value': str(note['duration'])})
            ET.SubElement(midi_note, 'Velocity', attrib={'Value': str(int(note['velocity']))})
            ET.SubElement(midi_note, 'IsEnabled', attrib={'Value': 'true'})
    
    return clip

def create_ableton_project(xm_info, samples, patterns, output_path):
    """Crée un projet Ableton Live avec structure par canal"""
    
    print(f"\nCréation du projet Ableton...")
    
    project_dir = os.path.dirname(output_path)
    
    # Organiser les pistes par canal
    tracks_data = organize_tracks_by_channel(
        patterns, 
        xm_info['pattern_order'], 
        samples,
        xm_info['channels']
    )
    
    # Créer un mapping instrument -> sample
    instrument_to_sample = {s['instrument']: s for s in samples}
    
    # Root
    ableton = ET.Element('Ableton', attrib={
        'MajorVersion': '5',
        'MinorVersion': '12.0_12115',
        'SchemaChangeCount': '3',
        'Creator': 'Ableton Live 12.1.5',
        'Revision': ''
    })
    
    liveset = ET.SubElement(ableton, 'LiveSet')
    
    # Master track
    master_track = ET.SubElement(liveset, 'MasterTrack', attrib={'Id': '0'})
    name = ET.SubElement(master_track, 'Name')
    ET.SubElement(name, 'EffectiveName', attrib={'Value': 'Master'})
    ET.SubElement(name, 'UserName', attrib={'Value': ''})
    ET.SubElement(name, 'Annotation', attrib={'Value': ''})
    ET.SubElement(name, 'MemorizedFirstClipName', attrib={'Value': ''})
    
    ET.SubElement(master_track, 'Color', attrib={'Value': '0'})
    ET.SubElement(master_track, 'AutomationEnvelopes')
    ET.SubElement(master_track, 'TrackGroupId', attrib={'Value': '-1'})
    
    device_chain = ET.SubElement(master_track, 'DeviceChain')
    mixer = ET.SubElement(device_chain, 'Mixer')
    tempo = ET.SubElement(mixer, 'Tempo')
    ET.SubElement(tempo, 'Manual', attrib={'Value': str(xm_info['bpm'])})
    
    # Tracks
    tracks = ET.SubElement(liveset, 'Tracks')
    
    track_id = 1
    device_id = 1
    clip_id = 1
    
    # Créer les pistes par canal
    for channel in sorted(tracks_data.keys()):
        for instrument, notes in sorted(tracks_data[channel].items()):
            if instrument not in instrument_to_sample:
                continue
            
            sample = instrument_to_sample[instrument]
            
            midi_track = ET.SubElement(tracks, 'MidiTrack', attrib={'Id': str(track_id)})
            
            ET.SubElement(midi_track, 'LomId', attrib={'Value': str(track_id)})
            ET.SubElement(midi_track, 'LomIdView', attrib={'Value': '0'})
            ET.SubElement(midi_track, 'IsContentSelected', attrib={'Value': 'false'})
            
            # Nom de la piste
            name = ET.SubElement(midi_track, 'Name')
            track_name = f"Ch{channel+1} - {sample['name']}"
            ET.SubElement(name, 'EffectiveName', attrib={'Value': track_name})
            ET.SubElement(name, 'UserName', attrib={'Value': ''})
            ET.SubElement(name, 'Annotation', attrib={'Value': ''})
            ET.SubElement(name, 'MemorizedFirstClipName', attrib={'Value': ''})
            
            ET.SubElement(midi_track, 'Color', attrib={'Value': str(channel + 1)})
            ET.SubElement(midi_track, 'AutomationEnvelopes')
            ET.SubElement(midi_track, 'TrackGroupId', attrib={'Value': '-1'})
            
            # DeviceChain
            device_chain = ET.SubElement(midi_track, 'DeviceChain')
            
            # Devices - Sampler
            device_chain_inner = ET.SubElement(device_chain, 'DeviceChain')
            devices = ET.SubElement(device_chain_inner, 'Devices')
            
            sampler = create_sampler_device(sample['path'], project_dir, device_id)
            devices.append(sampler)
            device_id += 1
            
            # MainSequencer avec clip MIDI
            main_seq = ET.SubElement(device_chain, 'MainSequencer')
            clip_slot_list = ET.SubElement(main_seq, 'ClipSlotList')
            clip_slot = ET.SubElement(clip_slot_list, 'ClipSlot', attrib={'Id': str(clip_id)})
            ET.SubElement(clip_slot, 'LomId', attrib={'Value': str(clip_id)})
            
            clip_slot_value = ET.SubElement(clip_slot, 'ClipSlot')
            value = ET.SubElement(clip_slot_value, 'Value')
            
            # Créer le clip avec les vraies notes
            midi_clip = create_midi_clip_with_notes(notes, clip_id)
            if midi_clip is not None:
                value.append(midi_clip)
            
            clip_id += 1
            
            ET.SubElement(midi_track, 'Freeze', attrib={'Value': 'false'})
            ET.SubElement(midi_track, 'VelocityDetail', attrib={'Value': '0'})
            ET.SubElement(midi_track, 'NeedArrangerRefreeze', attrib={'Value': 'false'})
            ET.SubElement(midi_track, 'PostProcessFreezeClips', attrib={'Value': '0'})
            
            track_id += 1
            
            print(f"  ✓ Piste créée: {track_name} ({len(notes)} notes)")
    
    # Autres éléments
    ET.SubElement(liveset, 'VisibleTracks')
    locators = ET.SubElement(liveset, 'Locators')
    ET.SubElement(locators, 'Locators')
    
    # Sauvegarder
    xml_str = ET.tostring(ableton, encoding='unicode')
    dom = minidom.parseString(xml_str)
    pretty_xml = dom.toprettyxml(indent='  ')
    
    with gzip.open(output_path, 'wt', encoding='utf-8') as f:
        f.write(pretty_xml)
    
    print(f"\n✓ Projet créé: {output_path}")
    
    return True

def convert_xm_to_ableton(xm_path, output_dir=None):
    """Convertit un fichier XM en projet Ableton"""
    
    if not os.path.exists(xm_path):
        print(f"Erreur: '{xm_path}' n'existe pas")
        return False
    
    print("="*60)
    print("CONVERSION XM → ABLETON LIVE")
    print("="*60)
    
    if not output_dir:
        xm_basename = os.path.splitext(os.path.basename(xm_path))[0]
        output_dir = os.path.join(os.path.dirname(xm_path), f"{xm_basename}_Ableton_Project")
    
    os.makedirs(output_dir, exist_ok=True)
    
    samples_dir = os.path.join(output_dir, 'Samples')
    os.makedirs(samples_dir, exist_ok=True)
    
    # Extraire samples ET patterns
    samples, patterns, xm_info = extract_samples_and_patterns(xm_path, samples_dir)
    
    if not samples:
        print("\n❌ Aucun sample extrait !")
        return False
    
    print(f"\n{'='*60}")
    print(f"MODULE: {xm_info['name']}")
    print(f"BPM: {xm_info['bpm']}")
    print(f"Canaux: {xm_info['channels']}")
    print(f"Samples: {len(samples)}")
    print(f"Patterns: {len(patterns)}")
    print(f"{'='*60}")
    
    # Créer le projet
    als_path = os.path.join(output_dir, f"{xm_info['name'].strip() or 'project'}.als")
    create_ableton_project(xm_info, samples, patterns, als_path)
    
    print(f"\n{'='*60}")
    print(f"✓ CONVERSION TERMINÉE")
    print(f"{'='*60}")
    print(f"\nProjet: {als_path}")
    print(f"Samples: {samples_dir}/")
    print(f"\n📝 STRUCTURE:")
    print(f"  • Une piste par canal/instrument utilisé")
    print(f"  • Les notes MIDI sont extraites du XM")
    print(f"  • Les Samplers sont pré-configurés avec les samples")
    print(f"  • Les pistes sont colorées par canal")
    print(f"\n💡 À FAIRE:")
    print(f"  • Ajuster les durées de notes si nécessaire")
    print(f"  • Ajouter les effets manuellement")
    print(f"  • Grouper les pistes du même sample si désiré")
    print(f"\nOuvrez le fichier .als dans Ableton Live 12 !")
    
    return True

def main():
    if len(sys.argv) < 2:
        print("Usage: python3 xm2live.py <fichier.xm> [dossier_sortie]")
        print("\nExemple:")
        print("  python3 xm2live.py mon_module.xm")
        print("  python3 xm2live.py mon_module.xm ./output/")
        sys.exit(1)
    
    xm_path = sys.argv[1]
    output_dir = sys.argv[2] if len(sys.argv) > 2 else None
    
    convert_xm_to_ableton(xm_path, output_dir)

if __name__ == "__main__":
    main()